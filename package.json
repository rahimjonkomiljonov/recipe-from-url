{
  "name": "recipe-from-url",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paste a URL (recipe website, YouTube, or Instagram) and auto-extract the recipe into a personal saved collection.",
  "scripts": {
    "dev": "concurrently -k -n client,server \"tsc -p tsconfig.client.json --watch\" \"tsx watch src/server/index.ts\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
