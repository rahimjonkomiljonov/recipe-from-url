  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/server/**/*.ts",
    "src/extractor/**/*.ts",
    "src/db/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
